{
  "name": "sticker-cards-c1-only",
  "mode": "deterministic",
  "registry": "fixtures/registry.json",
  "requiresWorkflows": [
    "mock-sticker-cards"
  ],
  "routeStub": [
    {
      "ifPromptContains": [
        "gatbf1",
        "小绿书卡片GateB mockstikercards"
      ],
      "reply": "{\"intent\": \"execute_workflow\", \"action\": \"start_execution\", \"workflowId\": \"mock-sticker-cards\", \"args\": {\"articleDir\": \"{articleDirFull}\", \"outFile\": \"{outFileFull}\", \"mode\": \"full\"}, \"missingFields\": [], \"reason\": \"wx-mock 卡片化 Gate B C1\", \"confidence\": 0.99}"
    },
    {
      "ifPromptContains": [
        "gatbdup"
      ],
      "reply": "{\"intent\": \"execute_workflow\", \"action\": \"start_execution\", \"workflowId\": \"mock-sticker-cards\", \"args\": {\"articleDir\": \"{articleDirDup}\", \"outFile\": \"{outFileDup}\", \"mode\": \"duplicate\"}, \"missingFields\": [], \"reason\": \"wx-mock 卡片化 Gate B C2\", \"confidence\": 0.99}"
    },
    {
      "ifPromptContains": [
        "gatbu"
      ],
      "reply": "{\"intent\": \"execute_workflow\", \"action\": \"start_execution\", \"workflowId\": \"mock-sticker-cards\", \"args\": {\"articleDir\": \"{articleDirU}\", \"outFile\": \"{outFileU}\", \"mode\": \"unknown-recover\"}, \"missingFields\": [], \"reason\": \"wx-mock 卡片化 Gate B C3\", \"confidence\": 0.99}"
    }
  ],
  "steps": [
    {
      "caseId": "C1",
      "name": "卡片化全链：build→render→normalize→审图→verify→发布 DRAFTED",
      "send": "小绿书卡片GateB mockstikercards gatbf1",
      "approve": "never",
      "expect": {
        "type": "taskCompleted",
        "workflowId": "mock-sticker-cards",
        "timeoutSec": 300
      },
      "assertFile": [
        "{outFileFull}"
      ],
      "assertFileContains": {
        "file": "{outFileFull}",
        "contains": "markers=BUILD,RENDER,NORMALIZE,APPROVED,VERIFY,FP,PUBLISH-DRAFTED"
      },
      "special": {
        "justified": true
      },
      "reason": "渲染+规范化+发布全链确定性执行（playwright 渲染含浏览器启动与字体开销），180s 不够"
    }
  ],
  "vars": {
    "articleDirFull": "{runDir}/work/sticker-full",
    "outFileFull": "{runDir}/work/sticker-full-out.txt"
  }
}